diff --git a/src/KinectCam/KinectHelper.cs b/src/KinectCam/KinectHelper.cs
index 8e469bf..beebe04 100644
--- a/src/KinectCam/KinectHelper.cs
+++ b/src/KinectCam/KinectHelper.cs
@@ -446,5 +446,135 @@ public unsafe static void GenerateFrame(IntPtr _ptr, int length, bool mirrored,
 					*pData++ = 0;
 			}
 		}
+
+		#region 多分辨率 / YUY2 输出
+
+		public enum FrameFormat
+		{
+			Rgb24,
+			Yuy2
+		}
+
+		// 完整一帧的临时缓冲（1920x1080 RGB24）
+		static readonly byte[] fullFrameBuffer = new byte[SensorWidth * SensorHeight * 3];
+		// 缩放后的临时缓冲，按需增长
+		static byte[] scaledFrameBuffer = new byte[0];
+
+		/// <summary>
+		/// 输出任意尺寸，RGB24 或 YUY2。
+		/// 先让 GenerateFrame 画一张完整的 1920x1080 RGB24，再缩放到目标尺寸；
+		/// 目标为 YUY2 时再做一次 4:2:2 色度抽样转换。
+		/// 原来只支持 1920x1080 及以上，导致要 640x480 / 1280x720 的程序连不上滤镜。
+		/// </summary>
+		public unsafe static void GenerateFrameEx(IntPtr _ptr, int _width, int _height, FrameFormat _format, bool mirrored, bool zoom)
+		{
+			if (_ptr == IntPtr.Zero || _width <= 0 || _height <= 0) return;
+
+			fixed (byte* _full = fullFrameBuffer)
+			{
+				GenerateFrame((IntPtr)_full, fullFrameBuffer.Length, mirrored, zoom);
+
+				int _scaledLength = _width * _height * 3;
+				if (scaledFrameBuffer.Length < _scaledLength) scaledFrameBuffer = new byte[_scaledLength];
+
+				fixed (byte* _scaled = scaledFrameBuffer)
+				{
+					ScaleRgb24(_full, SensorWidth, SensorHeight, _scaled, _width, _height);
+
+					if (_format == FrameFormat.Yuy2)
+					{
+						Rgb24ToYuy2(_scaled, _width, _height, (byte*)_ptr.ToPointer());
+					}
+					else
+					{
+						Buffer.MemoryCopy(_scaled, _ptr.ToPointer(), _scaledLength, _scaledLength);
+					}
+				}
+			}
+		}
+
+		/// <summary>
+		/// RGB24 面积平均缩放。内存序是 BGR（和 BI_RGB 一致），逐行处理所以不会改变上下方向。
+		/// </summary>
+		unsafe static void ScaleRgb24(byte* _src, int _srcWidth, int _srcHeight, byte* _dst, int _dstWidth, int _dstHeight)
+		{
+			for (int _y = 0; _y < _dstHeight; _y++)
+			{
+				int _sy0 = (int)((long)_y * _srcHeight / _dstHeight);
+				int _sy1 = (int)((long)(_y + 1) * _srcHeight / _dstHeight);
+				if (_sy1 <= _sy0) _sy1 = _sy0 + 1;
+				if (_sy1 > _srcHeight) _sy1 = _srcHeight;
+
+				for (int _x = 0; _x < _dstWidth; _x++)
+				{
+					int _sx0 = (int)((long)_x * _srcWidth / _dstWidth);
+					int _sx1 = (int)((long)(_x + 1) * _srcWidth / _dstWidth);
+					if (_sx1 <= _sx0) _sx1 = _sx0 + 1;
+					if (_sx1 > _srcWidth) _sx1 = _srcWidth;
+
+					int _b = 0, _g = 0, _r = 0, _n = 0;
+					for (int _sy = _sy0; _sy < _sy1; _sy++)
+					{
+						byte* _row = _src + (_sy * _srcWidth + _sx0) * 3;
+						for (int _sx = _sx0; _sx < _sx1; _sx++)
+						{
+							_b += _row[0];
+							_g += _row[1];
+							_r += _row[2];
+							_row += 3;
+							_n++;
+						}
+					}
+					*_dst++ = (byte)(_b / _n);
+					*_dst++ = (byte)(_g / _n);
+					*_dst++ = (byte)(_r / _n);
+				}
+			}
+		}
+
+		/// <summary>
+		/// RGB24 -> YUY2（4:2:2，字节序 Y0 U Y1 V）。
+		/// </summary>
+		unsafe static void Rgb24ToYuy2(byte* _src, int _width, int _height, byte* _dst)
+		{
+			for (int _y = 0; _y < _height; _y++)
+			{
+				byte* _row = _src + _y * _width * 3;
+				for (int _x = 0; _x < _width; _x += 2)
+				{
+					byte* _p0 = _row;
+					byte* _p1 = (_x + 1 < _width) ? _row + 3 : _row;
+
+					int _b0 = _p0[0], _g0 = _p0[1], _r0 = _p0[2];
+					int _b1 = _p1[0], _g1 = _p1[1], _r1 = _p1[2];
+
+					int _Y0 = (77 * _r0 + 150 * _g0 + 29 * _b0) >> 8;
+					int _Y1 = (77 * _r1 + 150 * _g1 + 29 * _b1) >> 8;
+					int _U = ((-43 * (_r0 + _r1) - 85 * (_g0 + _g1) + 128 * (_b0 + _b1)) >> 9) + 128;
+					int _V = ((128 * (_r0 + _r1) - 107 * (_g0 + _g1) - 21 * (_b0 + _b1)) >> 9) + 128;
+
+					*_dst++ = (byte)(_Y0 < 0 ? 0 : (_Y0 > 255 ? 255 : _Y0));
+					*_dst++ = (byte)(_U < 0 ? 0 : (_U > 255 ? 255 : _U));
+					*_dst++ = (byte)(_Y1 < 0 ? 0 : (_Y1 > 255 ? 255 : _Y1));
+					*_dst++ = (byte)(_V < 0 ? 0 : (_V > 255 ? 255 : _V));
+
+					_row += 6;
+				}
+			}
+		}
+
+		/// <summary>
+		/// 桌面捕获路径用：把一整块 RGB24 缓冲转成 YUY2 写进目标。
+		/// </summary>
+		public unsafe static void ConvertRgb24ToYuy2(byte[] _src, int _width, int _height, IntPtr _dst)
+		{
+			if (_src == null || _dst == IntPtr.Zero) return;
+			fixed (byte* _s = _src)
+			{
+				Rgb24ToYuy2(_s, _width, _height, (byte*)_dst.ToPointer());
+			}
+		}
+
+		#endregion
 	}
 }
